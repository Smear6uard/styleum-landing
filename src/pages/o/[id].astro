---
// Shared outfit page: rendered on demand from the public API.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Cta from '../../components/Cta.astro';
import { site } from '../../site';

const { id } = Astro.params;
const API_BASE = 'https://styleum-api-production.up.railway.app';

interface OutfitItem {
  image_url?: string;
  name?: string;
  category?: string;
}
interface Outfit {
  name?: string;
  vibe?: string;
  style_score?: number;
}

let outfit: Outfit | null = null;
let items: OutfitItem[] = [];
let error = false;

try {
  const response = await fetch(`${API_BASE}/api/public/outfits/${id}`);
  if (!response.ok) {
    error = true;
  } else {
    const data = await response.json();
    outfit = data.outfit ?? null;
    items = data.items ?? [];
  }
} catch (e) {
  console.error('Failed to fetch outfit:', e);
  error = true;
}

const ogImage = items[0]?.image_url || '/og-image.png';
const pageTitle = outfit?.name ? outfit.name : 'Outfit';
const pageDescription = outfit?.vibe || `An outfit styled with ${site.name}`;
const score = outfit?.style_score ?? 0;
---

<Layout title={pageTitle} description={pageDescription} image={ogImage} nav="dark">
  <Nav />
  <main id="main" class="look">
    {error ? (
      <div class="wrap look__empty">
        <p class="eyebrow">Not found</p>
        <h1 class="display h2">This outfit is gone.</h1>
        <p class="lede muted">It may have been removed, or the link is wrong.</p>
        <a class="btn btn--solid" href="/">Back to Styleum</a>
      </div>
    ) : (
      <div class="wrap look__grid">
        <div class="look__items" data-count={Math.min(items.length, 4)}>
          {items.slice(0, 4).map((item) => (
            <figure class="look__item">
              <div class="look__img">
                <img src={item.image_url} alt={item.name || item.category || 'Item'} loading="lazy" decoding="async" />
              </div>
              <figcaption>
                <span class="look__name">{item.name || item.category}</span>
                <span class="look__cat mono">{item.category}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="look__info">
          <p class="eyebrow">Styled with {site.name}</p>
          <h1 class="display h2">{outfit?.name || 'Today’s look'}</h1>
          {outfit?.vibe && <p class="lede muted">{outfit.vibe}</p>}
          <div class="look__score">
            <span class="display look__num">{score}</span>
            <span class="mono look__label">Style<br />score</span>
          </div>
          <div class="look__cta">
            <Cta variant="solid" />
            <p class="mono muted">Four looks from your own closet, every morning at {site.ritualTime}.</p>
          </div>
        </div>
      </div>
    )}
  </main>
  <Footer />
</Layout>

<style>
  .look {
    background: var(--color-chalk);
    color: var(--color-ink);
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 7vw, 5rem));
    padding-bottom: clamp(5rem, 12vw, 9rem);
    min-height: 80vh;
  }
  .look__empty {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .look__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .look__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .look__items[data-count='1'] {
    grid-template-columns: minmax(0, 20rem);
    justify-content: center;
  }
  .look__item {
    margin: 0;
  }
  .look__img {
    aspect-ratio: 1;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    padding: 1rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .look__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.7rem;
  }
  .look__name {
    font-weight: 600;
  }
  .look__cat {
    opacity: 0.55;
    text-transform: capitalize;
  }
  .look__info .h2 {
    margin: 1.25rem 0 1rem;
  }
  .look__score {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 2rem 0 2.5rem;
  }
  .look__num {
    font-size: clamp(4rem, 8vw, 6.5rem);
    line-height: 0.9;
  }
  .look__label {
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.6;
  }
  .look__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .look__cta p {
    margin: 0;
  }

  @media (min-width: 860px) {
    .look__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
