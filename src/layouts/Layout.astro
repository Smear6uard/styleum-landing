---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
  /** Nav text colour at the top of the page */
  nav?: 'light' | 'dark';
}

const {
  title,
  description,
  image = '/og-image.png',
  type = 'website',
  schema = [],
  nav = 'light',
} = Astro.props;

const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url);
const imageUrl = new URL(image, site.url).href;

const orgData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: `${site.url}/android-chrome-512x512.png`,
  email: site.email,
  sameAs: [site.social.instagram, site.social.tiktok],
};

const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
};

const appData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  alternateName: site.storeName,
  ...(site.app.storeUrl ? { installUrl: site.app.storeUrl, downloadUrl: site.app.storeUrl } : {}),
  operatingSystem: 'iOS',
  applicationCategory: 'LifestyleApplication',
  description: site.description,
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: site.pro.price.replace('$', ''),
    priceCurrency: 'USD',
    offerCount: '2',
  },
};

const fonts =
  'https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Geist+Mono:wght@400..600&family=Schibsted+Grotesk:ital,wght@0,400..800;1,400..800&display=swap';
---

<!doctype html>
<html lang="en" data-nav={nav}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b0c10" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(orgData)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteData)} />
    <script type="application/ld+json" set:html={JSON.stringify(appData)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
