---
/**
 * The one call to action, everywhere. Reads the store link from site config
 * and shows the Apple mark when it points at the App Store.
 */
import { cta } from '../site';

interface Props {
  variant?: 'chalk' | 'solid' | 'ghost';
  size?: 'sm' | 'md';
  text?: 'full' | 'short';
  class?: string;
}

const { variant = 'solid', size = 'md', text = 'full', class: className = '', ...rest } = Astro.props;
const label = text === 'short' ? cta.short : cta.label;
---

<a
  {...rest}
  class:list={['btn', `btn--${variant}`, { 'btn--sm': size === 'sm' }, className]}
  href={cta.href}
  target={cta.external ? '_blank' : undefined}
  rel={cta.external ? 'noopener' : undefined}
>
  {cta.apple && (
    <svg class="btn__apple" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
    </svg>
  )}
  <span>{label}</span>
  {!cta.apple && (
    <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  )}
</a>

<style>
  .btn__apple {
    width: 1.1rem;
    height: 1.1rem;
    transform: translateY(-1px);
  }
  .btn--sm .btn__apple {
    width: 0.95rem;
    height: 0.95rem;
  }
</style>
