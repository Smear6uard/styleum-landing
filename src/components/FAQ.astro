---
import { faqs } from '../content/faqs';
---

<section id="faq" class="faq section" data-nav-theme="dark">
  <div class="wrap faq__grid">
    <div class="faq__head">
      <p class="eyebrow" data-reveal>Questions</p>
      <h2 class="display h2" data-lines>
        <span class="line"><span class="line__in">Before</span></span>
        <span class="line"><span class="line__in">you <em>ask.</em></span></span>
      </h2>
    </div>

    <div class="faq__list">
      {faqs.map((f, i) => (
        <details class="q" data-reveal style={`--d:${i * 60}ms`}>
          <summary>
            <span>{f.q}</span>
            <span class="q__mark" aria-hidden="true"></span>
          </summary>
          <div class="q__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Animate the answer height; native <details> keeps keyboard and no-JS behaviour.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLDetailsElement>('details.q').forEach((d) => {
    const summary = d.querySelector('summary')!;
    const body = d.querySelector<HTMLElement>('.q__a')!;
    summary.addEventListener('click', (e) => {
      if (reduce) return;
      e.preventDefault();
      if (d.open) {
        const h = body.offsetHeight;
        body.style.height = `${h}px`;
        requestAnimationFrame(() => {
          body.style.height = '0px';
        });
        body.addEventListener(
          'transitionend',
          () => {
            d.open = false;
            body.style.height = '';
          },
          { once: true },
        );
      } else {
        d.open = true;
        const h = body.scrollHeight;
        body.style.height = '0px';
        requestAnimationFrame(() => {
          body.style.height = `${h}px`;
        });
        body.addEventListener(
          'transitionend',
          () => {
            body.style.height = '';
          },
          { once: true },
        );
      }
    });
  });
</script>

<style>
  .faq {
    background: var(--color-chalk);
    color: var(--color-ink);
  }
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .faq__head .h2 {
    margin-top: 1.25rem;
  }
  .faq__list {
    border-top: 1px solid var(--color-line);
  }
  .q {
    border-bottom: 1px solid var(--color-line);
  }
  .q summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 0;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.3s;
  }
  .q summary::-webkit-details-marker {
    display: none;
  }
  .q summary:hover {
    color: var(--color-graphite);
  }
  .q__mark {
    position: relative;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    transition: transform 0.6s var(--ease-out-expo), background-color 0.3s, border-color 0.3s;
  }
  .q__mark::before,
  .q__mark::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.65rem;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .q__mark::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .q[open] .q__mark {
    transform: rotate(135deg);
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-chalk);
  }
  .q__a {
    overflow: hidden;
    transition: height 0.55s var(--ease-out-expo);
  }
  .q__a p {
    margin: 0;
    padding: 0 0 1.6rem;
    max-width: 40rem;
    color: var(--color-graphite);
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
      align-items: start;
    }
    .faq__head {
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
    }
  }
</style>
