---
import { site } from '../site';

const groups = [
  {
    title: 'Product',
    links: [
      { label: 'How it works', href: '/#wardrobe' },
      { label: 'Read the label', href: '/#label' },
      { label: 'Pricing', href: '/#pricing' },
      { label: 'FAQ', href: '/#faq' },
    ],
  },
  {
    title: 'Help',
    links: [
      { label: 'Support', href: '/support' },
      { label: 'Contact', href: `mailto:${site.email}` },
      { label: 'Instagram', href: site.social.instagram },
      { label: 'TikTok', href: site.social.tiktok },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Terms', href: '/terms' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="footer" data-nav-theme="light">
  <div class="wrap">
    <div class="footer__top">
      <a class="footer__brand" href="/" aria-label="Styleum home">
        <img src="/StyleumLogo1.png" alt="" width="34" height="34" decoding="async" loading="lazy" />
        <span class="footer__word display">{site.name}</span>
      </a>
      <nav class="footer__groups" aria-label="Footer">
        {groups.map((g) => (
          <div class="footer__group">
            <p class="eyebrow">{g.title}</p>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="footer__bottom mono">
      <span>© {year} {site.company}</span>
      <span>{site.tagline}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-chalk);
    border-top: 1px solid var(--color-line-dark);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    align-self: start;
  }
  .footer__brand img {
    width: 34px;
    height: 34px;
    filter: invert(1);
  }
  .footer__word {
    font-size: 2rem;
    line-height: 1;
  }
  .footer__groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .footer__group ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer__group a {
    text-decoration: none;
    opacity: 0.72;
    font-size: 0.95rem;
    transition: opacity 0.3s;
  }
  .footer__group a:hover {
    opacity: 1;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line-dark);
    opacity: 0.5;
  }

  @media (min-width: 760px) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }
  }
</style>
