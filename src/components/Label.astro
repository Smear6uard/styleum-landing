---
/**
 * The promises, written the way garments state theirs: on a care label with
 * five symbols. Hover a symbol and its claim lights up; hover a claim and the
 * symbol answers.
 */
import { site } from '../site';

const claims = [
  {
    id: 'own',
    label: '100% your wardrobe',
    title: 'Works with what you own.',
    body: 'Styleum never suggests something you would have to buy. It is your closet, combined better.',
    icon: `<path d="M8 19c11 7 21 7 32 0l-4 19H12z"/><path d="M15 26c3 2.5 6 2.5 9 0s6-2.5 9 0"/>`,
  },
  {
    id: 'weather',
    label: 'Weather-checked',
    title: 'Checked against the forecast.',
    body: 'Every look is built for the weather where you are, that morning. No wool in a heatwave, no linen in sleet.',
    icon: `<circle cx="24" cy="24" r="7"/><path d="M24 7v4M24 37v4M7 24h4M37 24h4M12 12l3 3M33 33l3 3M12 36l3-3M33 15l3-3"/>`,
  },
  {
    id: 'learn',
    label: 'Learns from wear',
    title: 'Learns from every pick.',
    body: 'What you wear and what you skip tune tomorrow’s four. It gets sharper by the week.',
    icon: `<path d="M35 18a13 13 0 1 0 2 12"/><path d="M37 11v8h-8"/>`,
  },
  {
    id: 'noshop',
    label: 'Not a store',
    title: 'Not a store.',
    body: 'Styleum does not sell clothes or push new ones. The point is more from what is already hanging up.',
    icon: `<path d="M13 18h22l2 20H11z"/><path d="M18 18v-3a6 6 0 0 1 12 0v3"/><path d="M9 41L39 7"/>`,
  },
  {
    id: 'private',
    label: 'Never trains AI',
    title: 'Your photos stay yours.',
    body: 'Wardrobe photos are used only to build your outfits. They are never used to train AI models.',
    icon: `<rect x="8" y="10" width="32" height="26" rx="2"/><path d="M8 32l9-9 7 7 5-5 11 11"/><circle cx="31" cy="18" r="2.5"/><rect x="26" y="30" width="14" height="10" rx="2" fill="var(--label-bg)"/><path d="M29 30v-3a4 4 0 0 1 8 0v3"/>`,
  },
];
---

<section id="label" class="label section" data-nav-theme="dark">
  <div class="wrap label__grid">
    <div class="label__intro">
      <p class="eyebrow" data-reveal>Care instructions</p>
      <h2 class="display h2" data-lines>
        <span class="line"><span class="line__in">Read</span></span>
        <span class="line"><span class="line__in">the <em>label.</em></span></span>
      </h2>
      <p class="lede muted" data-reveal style="--d:120ms">
        Every garment carries a label that says how it behaves. This one is ours.
      </p>
    </div>

    <div class="label__tag" data-reveal style="--d:160ms">
      <div class="tag" id="care-tag">
        <span class="tag__hole"></span>
        <div class="tag__brand">{site.name}</div>
        <div class="tag__line">100% your wardrobe</div>
        <div class="tag__symbols">
          {claims.map((c) => (
            <button class="sym" type="button" data-claim={c.id} aria-label={c.label} title={c.label}>
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
            </button>
          ))}
        </div>
        <div class="tag__meta">
          <span>Made for {site.ritualTime} AM</span>
          <span>{site.app.platform}</span>
        </div>
        <div class="tag__warn">Do not buy new</div>
      </div>
    </div>

    <ol class="claims" id="claims">
      {claims.map((c, i) => (
        <li class="claim" data-claim={c.id} data-reveal style={`--d:${i * 70}ms`}>
          <div class="claim__icon">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
          </div>
          <div>
            <h3 class="claim__title">{c.title}</h3>
            <p class="claim__body">{c.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const tag = document.getElementById('care-tag');
  const list = document.getElementById('claims');
  if (tag && list) {
    const syms = Array.from(tag.querySelectorAll<HTMLElement>('.sym'));
    const claims = Array.from(list.querySelectorAll<HTMLElement>('.claim'));
    const highlight = (id: string | null) => {
      list.classList.toggle('is-hl', !!id);
      tag.classList.toggle('is-hl', !!id);
      for (const el of [...syms, ...claims]) el.classList.toggle('is-hl', !!id && el.dataset.claim === id);
    };
    for (const el of [...syms, ...claims]) {
      el.addEventListener('pointerenter', () => highlight(el.dataset.claim ?? null));
      el.addEventListener('pointerleave', () => highlight(null));
      el.addEventListener('focusin', () => highlight(el.dataset.claim ?? null));
      el.addEventListener('focusout', () => highlight(null));
    }
  }
</script>

<style>
  .label {
    --label-bg: var(--color-paper);
    background: var(--color-chalk);
    color: var(--color-ink);
  }
  .label__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 6vw, 5rem);
  }
  .label__intro .h2 {
    margin: 1.25rem 0 1.5rem;
  }

  .label__tag {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    perspective: 1200px;
  }
  .tag {
    position: relative;
    width: min(100%, 22rem);
    padding: 2.75rem 2rem 2.25rem;
    background: var(--label-bg);
    border: 1px solid var(--color-line);
    border-radius: 0.4rem;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.03),
      0 30px 60px -30px rgba(11, 12, 16, 0.35);
    text-align: center;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    transform: rotate(-2.5deg);
    transition: transform 0.9s var(--ease-out-expo), box-shadow 0.9s var(--ease-out-expo);
  }
  .tag::before {
    content: '';
    position: absolute;
    inset: 0.55rem;
    border: 1px dashed color-mix(in srgb, var(--color-ink) 22%, transparent);
    border-radius: 0.2rem;
    pointer-events: none;
  }
  .tag:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.03),
      0 40px 70px -30px rgba(11, 12, 16, 0.45);
  }
  .tag__hole {
    position: absolute;
    top: 1.05rem;
    left: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    transform: translateX(-50%);
    background: var(--color-chalk);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 22%, transparent);
  }
  .tag__brand {
    font-family: var(--font-display);
    font-style: italic;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: 2.6rem;
    line-height: 1;
    margin-bottom: 0.4rem;
  }
  .tag__line {
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }
  .tag__symbols {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }
  .sym {
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    display: grid;
    place-items: center;
    color: var(--color-ink);
    transition: background-color 0.3s, color 0.3s, opacity 0.3s, transform 0.5s var(--ease-out-expo);
  }
  .sym svg {
    width: 2rem;
    height: 2rem;
  }
  .sym:hover,
  .sym.is-hl {
    background: var(--color-ink);
    color: var(--color-chalk);
    --label-bg: var(--color-ink);
    transform: translateY(-2px);
  }
  .tag.is-hl .sym:not(.is-hl) {
    opacity: 0.35;
  }
  .tag__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    opacity: 0.7;
  }
  .tag__meta span:last-child {
    text-transform: none;
  }
  .tag__warn {
    margin-top: 1rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-ink);
    border-radius: 0.2rem;
    display: inline-block;
    font-weight: 600;
  }

  .claims {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-line);
  }
  .claim {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 1.25rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-line);
    transition: opacity 0.4s;
  }
  .claims.is-hl .claim:not(.is-hl) {
    opacity: 0.32;
  }
  .claim__icon {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.6rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
    --label-bg: var(--color-paper);
  }
  .claim__icon svg {
    width: 2rem;
    height: 2rem;
  }
  .claim.is-hl .claim__icon,
  .claim:hover .claim__icon {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-chalk);
    --label-bg: var(--color-ink);
  }
  .claim__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0.35rem 0 0.5rem;
  }
  .claim__body {
    margin: 0;
    color: var(--color-graphite);
    max-width: 34rem;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .label__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: clamp(3rem, 8vw, 8rem);
      row-gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
    .label__intro {
      grid-column: 1;
      grid-row: 1;
    }
    .label__tag {
      grid-column: 2;
      grid-row: 1 / span 2;
      position: sticky;
      top: calc(var(--nav-h) + 3rem);
      justify-content: flex-end;
      padding-right: 2rem;
    }
    .claims {
      grid-column: 1;
      grid-row: 2;
    }
  }
</style>
