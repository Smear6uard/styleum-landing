---
/**
 * The product, rendered in code. One device, five screens, switched by
 * data-screen (set from scroll position) and data-occasion (set by the
 * Style Me chips). All sizing is in container-query units so the phone
 * scales from 190px to 390px wide without a single media query.
 */
import Garment from './Garment.astro';
import { items, todaysFour, occasions, resolve, weather, streakDays } from '../content/wardrobe';
import { site } from '../site';

const now = new Date();
const dateLabel = now.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
const weekday = now.toLocaleDateString('en-US', { weekday: 'long' });
const featured = todaysFour[0];
const wardrobe = items.slice(0, 12);
---

<div class="phone" id="phone" data-screen="lock" data-occasion="date" aria-hidden="true">
  <div class="phone__glow"></div>

  <div class="phone__body">
    <div class="phone__frame">
      <div class="stack">
        <!-- 9:00 · Lock screen -->
        <section class="screen screen--lock" data-name="lock">
          <div class="lock__sky"></div>
          <div class="lock__sun"></div>
          <div class="lock__date" data-date>{dateLabel}</div>
          <div class="lock__time">{site.ritualTime}</div>

          <div class="notif">
            <div class="notif__icon"><img src="/StyleumLogo1.png" alt="" width="40" height="40" decoding="async" /></div>
            <div class="notif__text">
              <div class="notif__row"><span class="notif__app">Styleum</span><span class="notif__when">now</span></div>
              <div class="notif__title">Your four looks are ready</div>
              <div class="notif__body">{weather.temp} and {weather.label.toLowerCase()}, {weather.note}. Tap to see this morning’s picks.</div>
            </div>
          </div>

          <div class="lock__controls">
            <span class="lock__ctl">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M8 3h8v3l-2 4v11h-4V10L8 6z" /><path d="M8 6h8" /></svg>
            </span>
            <span class="lock__ctl">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
            </span>
          </div>
        </section>

        <!-- Wardrobe -->
        <section class="screen screen--app" data-name="wardrobe">
          <header class="app__head">
            <div>
              <div class="app__kicker">Wardrobe</div>
              <div class="app__title">48 items</div>
            </div>
            <span class="app__plus">+</span>
          </header>
          <div class="chips">
            <span class="chip is-on">All</span><span class="chip">Tops</span><span class="chip">Layers</span><span class="chip">Bottoms</span><span class="chip">Shoes</span>
          </div>
          <div class="grid">
            {wardrobe.map((it, i) => (
              <div class="tile" style={`--i:${i}`}>
                <div class="tile__img"><Garment kind={it.kind} color={it.color} /></div>
                <div class="tile__name">{it.name}</div>
                <div class="tile__cat">{it.material}</div>
              </div>
            ))}
          </div>
          <div class="idtag">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            Identified · Navy overshirt · cotton twill
          </div>
        </section>

        <!-- Today's four -->
        <section class="screen screen--app" data-name="today">
          <header class="app__head">
            <div>
              <div class="app__kicker"><span data-weekday>{weekday}</span> · {site.ritualTime}</div>
              <div class="app__title">Today’s four</div>
            </div>
            <span class="wx">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
              {weather.temp} {weather.label}
            </span>
          </header>
          <div class="cards">
            {todaysFour.map((o, i) => (
              <div class="card" style={`--i:${i}`}>
                <div class="fit fit--sm">
                  {resolve(o.itemIds).map((it) => <div class="fit__g"><Garment kind={it.kind} color={it.color} /></div>)}
                </div>
                <div class="card__meta">
                  <div class="card__name">{o.name}</div>
                  <div class="card__vibe">{o.vibe}</div>
                </div>
                <div class="score">
                  <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.5" fill="none" stroke="#E4E2DB" stroke-width="2.6" /><circle cx="18" cy="18" r="15.5" fill="none" stroke="#111" stroke-width="2.6" pathLength="100" stroke-dasharray={`${o.score} 100`} stroke-linecap="round" transform="rotate(-90 18 18)" /></svg>
                  <span>{o.score}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="today__foot">
            <div class="wearbtn wearbtn--ghost">Not these? Style Me</div>
            <div class="today__hint">Swipe a look to skip it. Skips teach Styleum too.</div>
          </div>
        </section>

        <!-- Wear it -->
        <section class="screen screen--app" data-name="wear">
          <header class="app__head">
            <div>
              <div class="app__kicker">Wearing today</div>
              <div class="app__title">{featured.name}</div>
            </div>
            <div class="score score--lg">
              <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.5" fill="none" stroke="#E4E2DB" stroke-width="2.6" /><circle cx="18" cy="18" r="15.5" fill="none" stroke="#111" stroke-width="2.6" pathLength="100" stroke-dasharray={`${featured.score} 100`} stroke-linecap="round" transform="rotate(-90 18 18)" /></svg>
              <span>{featured.score}</span>
            </div>
          </header>
          <div class="fit fit--lg">
            {resolve(featured.itemIds).map((it) => <div class="fit__g"><Garment kind={it.kind} color={it.color} /></div>)}
          </div>
          <div class="wearbtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            Wearing this
          </div>
          <div class="streak">
            <div class="streak__row">
              {Array.from({ length: 7 }).map((_, i) => <span class:list={['dot', { 'dot--today': i === 6 }]} style={`--i:${i}`} />)}
            </div>
            <div class="streak__label">Day {streakDays} streak</div>
          </div>
          <div class="learn"><span class="learn__k">Learned</span>Skipped loafers 3× in rain → fewer on wet days.</div>
          <div class="recent">
            <div class="recent__k">Recent</div>
            {[
              { day: 'Mon', name: 'Clean lines', score: 91 },
              { day: 'Sun', name: 'Layered up', score: 89 },
              { day: 'Sat', name: 'Soft neutrals', score: 86 },
            ].map((r, i) => (
              <div class="recent__row" style={`--i:${i}`}>
                <span class="recent__day">{r.day}</span>
                <span class="recent__name">{r.name}</span>
                <span class="recent__score">{r.score}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Style Me -->
        <section class="screen screen--app" data-name="styleme">
          <header class="app__head">
            <div>
              <div class="app__kicker">Style Me · Pro</div>
              <div class="app__title">What’s the occasion?</div>
            </div>
          </header>
          <div class="chips chips--occ">
            {occasions.map((o) => <span class="chip" data-occ={o.id}>{o.label}</span>)}
          </div>
          <div class="occs">
            {occasions.map((o) => (
              <div class="occ" data-occ={o.id}>
                <div class="fit fit--lg">
                  {resolve(o.itemIds).map((it) => <div class="fit__g"><Garment kind={it.kind} color={it.color} /></div>)}
                </div>
                <div class="occ__title">{o.title}</div>
                <div class="occ__note">{o.note}</div>
                <div class="wearbtn wearbtn--ghost">Wear this</div>
              </div>
            ))}
          </div>
        </section>
      </div>

      <div class="island"></div>
      <div class="statusbar">
        <span class="statusbar__time">{site.ritualTime}</span>
        <span class="statusbar__right">
          <svg class="ic-signal" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx=".7" /><rect x="5" y="5.5" width="3" height="6.5" rx=".7" /><rect x="10" y="3" width="3" height="9" rx=".7" /><rect x="15" y="0" width="3" height="12" rx=".7" /></svg>
          <svg class="ic-wifi" viewBox="0 0 16 12" fill="currentColor"><path d="M8 11.2 10.4 8.4a3.4 3.4 0 0 0-4.8 0Z" /><path d="M3.6 5.6a6.5 6.5 0 0 1 8.8 0l-1.4 1.6a4.4 4.4 0 0 0-6 0Z" /><path d="M.8 2.6a10.5 10.5 0 0 1 14.4 0l-1.4 1.6a8.4 8.4 0 0 0-11.6 0Z" /></svg>
          <svg class="ic-batt" viewBox="0 0 27 12" fill="currentColor"><rect x=".5" y=".5" width="22" height="11" rx="3" fill="none" stroke="currentColor" stroke-opacity=".4" /><rect x="2" y="2" width="19" height="8" rx="1.8" /><path d="M24.5 4v4a2 2 0 0 0 0-4" opacity=".4" /></svg>
        </span>
      </div>
      <div class="homebar"></div>
    </div>
  </div>
</div>

<script>
  // The lock screen always shows the visitor's real date.
  const d = new Date();
  const date = document.querySelector('[data-date]');
  const weekday = document.querySelector('[data-weekday]');
  if (date) date.textContent = d.toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
  if (weekday) weekday.textContent = d.toLocaleDateString(undefined, { weekday: 'long' });
</script>

<style>
  .phone {
    position: relative;
    width: 100%;
    container-type: inline-size;
  }

  /* A soft gradient instead of a blur filter: the same glow, no per-frame filter cost on phones */
  .phone__glow {
    position: absolute;
    inset: -18% -30%;
    pointer-events: none;
    background: radial-gradient(
      50% 46% at 50% 46%,
      rgba(233, 180, 142, 0.32) 0%,
      rgba(200, 150, 140, 0.22) 24%,
      rgba(91, 108, 158, 0.16) 46%,
      rgba(91, 108, 158, 0.05) 64%,
      transparent 78%
    );
    transition: opacity 1s var(--ease-ios);
    animation: breathe 7s ease-in-out infinite;
  }
  .phone:not([data-screen='lock']) .phone__glow {
    opacity: 0;
  }

  .phone__body {
    position: relative;
    width: 100%;
    aspect-ratio: 390 / 844;
    border-radius: 14.5cqw;
    background: #0a0a0c;
    padding: 2.3cqw;
    box-shadow:
      0 0 0 0.45cqw #2a2b31,
      0 0 0 0.75cqw #0c0c0f,
      0 60px 90px -40px rgba(0, 0, 0, 0.75),
      0 30px 50px -30px rgba(0, 0, 0, 0.5);
  }
  .phone__body::before {
    content: '';
    position: absolute;
    inset: -0.9cqw;
    border-radius: 15.5cqw;
    background: linear-gradient(160deg, #46474e, #121317 38%, #1d1e24 66%, #4a4b52);
    z-index: -1;
  }
  /* side buttons */
  .phone__body::after {
    content: '';
    position: absolute;
    left: -1.6cqw;
    top: 26cqw;
    width: 0.8cqw;
    height: 8cqw;
    border-radius: 1cqw;
    background: #2a2b31;
    box-shadow:
      0 13cqw 0 #2a2b31,
      0 25cqw 0 #2a2b31,
      102.4cqw 4cqw 0 #2a2b31;
  }

  .phone__frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 12.3cqw;
    overflow: hidden;
    background: #000;
    isolation: isolate;
    transform: translateZ(0);
  }
  .stack {
    position: absolute;
    inset: 0;
  }
  .screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 0.6s var(--ease-ios),
      transform 0.8s var(--ease-ios);
    pointer-events: none;
  }
  .phone[data-screen='lock'] .screen[data-name='lock'],
  .phone[data-screen='wardrobe'] .screen[data-name='wardrobe'],
  .phone[data-screen='today'] .screen[data-name='today'],
  .phone[data-screen='wear'] .screen[data-name='wear'],
  .phone[data-screen='styleme'] .screen[data-name='styleme'] {
    opacity: 1;
    transform: none;
  }

  /* Chrome */
  .island {
    position: absolute;
    top: 2.9cqw;
    left: 50%;
    transform: translateX(-50%);
    width: 30cqw;
    height: 8.6cqw;
    border-radius: 99px;
    background: #000;
    z-index: 6;
  }
  .statusbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 12.5cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7cqw 0 8.5cqw;
    font-family: var(--font-ui);
    font-size: 3.9cqw;
    font-weight: 600;
    color: #111;
    z-index: 5;
    transition: color 0.5s;
  }
  .statusbar__right {
    display: inline-flex;
    align-items: center;
    gap: 1.6cqw;
  }
  .ic-signal { width: 4.4cqw; }
  .ic-wifi { width: 4cqw; }
  .ic-batt { width: 6.6cqw; }
  .phone[data-screen='lock'] .statusbar {
    color: #fff;
  }
  .phone[data-screen='lock'] .statusbar__time {
    opacity: 0;
  }
  .homebar {
    position: absolute;
    bottom: 2.3cqw;
    left: 50%;
    transform: translateX(-50%);
    width: 34cqw;
    height: 1.3cqw;
    border-radius: 99px;
    background: #111;
    opacity: 0.85;
    z-index: 6;
    transition: background-color 0.5s;
  }
  .phone[data-screen='lock'] .homebar {
    background: #fff;
  }

  /* Lock */
  .screen--lock {
    font-family: var(--font-ui);
    color: #fff;
  }
  .lock__sky {
    position: absolute;
    inset: 0;
    background: var(--sky);
  }
  .lock__sun {
    position: absolute;
    left: 50%;
    top: 78%;
    width: 90cqw;
    height: 90cqw;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(255, 226, 196, 0.6), rgba(233, 180, 142, 0.2) 38%, transparent 68%);
  }
  .lock__date {
    position: absolute;
    top: 14.5cqw;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 4.3cqw;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0.9;
  }
  .lock__time {
    position: absolute;
    top: 18.5cqw;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 23cqw;
    font-weight: 250;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .notif {
    position: absolute;
    top: 47cqw;
    left: 3.6cqw;
    right: 3.6cqw;
    display: flex;
    gap: 3cqw;
    padding: 3.2cqw 3.4cqw;
    border-radius: 6.5cqw;
    background: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.16),
      0 10cqw 14cqw -10cqw rgba(0, 0, 0, 0.45);
  }
  .phone[data-screen='lock'] .notif {
    animation: notifIn 1s var(--ease-ios) both;
    animation-delay: var(--notif-delay, 1.25s);
  }
  .notif__icon {
    flex: none;
    width: 10cqw;
    height: 10cqw;
    border-radius: 2.6cqw;
    background: #f4f3ee;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .notif__icon img {
    width: 74%;
    height: 74%;
  }
  .notif__text {
    min-width: 0;
  }
  .notif__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 3.4cqw;
    margin-bottom: 0.4cqw;
  }
  .notif__app {
    font-weight: 600;
  }
  .notif__when {
    opacity: 0.6;
    font-size: 3cqw;
  }
  .notif__title {
    font-size: 3.6cqw;
    font-weight: 600;
    line-height: 1.25;
  }
  .notif__body {
    font-size: 3.3cqw;
    line-height: 1.3;
    opacity: 0.86;
    margin-top: 0.5cqw;
  }
  .lock__controls {
    position: absolute;
    left: 9cqw;
    right: 9cqw;
    bottom: 8cqw;
    display: flex;
    justify-content: space-between;
  }
  .lock__ctl {
    width: 12.5cqw;
    height: 12.5cqw;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }
  .lock__ctl svg {
    width: 5.6cqw;
    height: 5.6cqw;
  }

  /* App */
  .screen--app {
    background: #f7f6f2;
    color: #111;
    font-family: var(--font-ui);
    padding: 15cqw 4.6cqw 0;
    overflow: hidden;
  }
  .app__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3.8cqw;
  }
  .app__kicker {
    font-size: 3.1cqw;
    font-weight: 500;
    color: #8a8a8e;
    margin-bottom: 0.6cqw;
  }
  .app__title {
    font-size: 7.2cqw;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .app__plus {
    width: 9.5cqw;
    height: 9.5cqw;
    border-radius: 50%;
    background: #111;
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 6cqw;
    font-weight: 400;
    line-height: 1;
    padding-bottom: 0.6cqw;
  }
  .wx {
    display: inline-flex;
    align-items: center;
    gap: 1.4cqw;
    font-size: 3.1cqw;
    font-weight: 600;
    padding: 1.8cqw 2.8cqw;
    border-radius: 99px;
    background: #fff;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05), 0 2cqw 5cqw -3cqw rgba(0, 0, 0, 0.15);
    white-space: nowrap;
  }
  .wx svg {
    width: 3.6cqw;
    height: 3.6cqw;
    color: #c98a55;
  }

  .chips {
    display: flex;
    gap: 2cqw;
    margin-bottom: 3.8cqw;
    overflow: hidden;
  }
  .chip {
    flex: none;
    font-size: 3.1cqw;
    font-weight: 600;
    padding: 1.9cqw 3.4cqw;
    border-radius: 99px;
    background: #ebe9e3;
    color: #444;
    white-space: nowrap;
    transition: background-color 0.35s, color 0.35s;
  }
  .chip.is-on,
  .phone[data-occasion='date'] .chip[data-occ='date'],
  .phone[data-occasion='interview'] .chip[data-occ='interview'],
  .phone[data-occasion='friday'] .chip[data-occ='friday'],
  .phone[data-occasion='wedding'] .chip[data-occ='wedding'] {
    background: #111;
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.8cqw;
  }
  .tile__img {
    aspect-ratio: 1;
    background: #ebe9e3;
    border-radius: 3.4cqw;
    padding: 3.2cqw;
  }
  .tile__name {
    font-size: 2.9cqw;
    font-weight: 600;
    margin-top: 1.7cqw;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tile__cat {
    font-size: 2.6cqw;
    color: #8a8a8e;
  }
  .phone[data-screen='wardrobe'] .tile {
    animation: popIn 0.7s var(--ease-ios) both;
    animation-delay: calc(140ms + var(--i) * 45ms);
  }
  .idtag {
    position: absolute;
    left: 5cqw;
    top: 113cqw;
    display: inline-flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 1.9cqw 3cqw 1.9cqw 2.4cqw;
    border-radius: 99px;
    background: #111;
    color: #fff;
    font-size: 2.7cqw;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 6cqw 10cqw -6cqw rgba(0, 0, 0, 0.5);
    opacity: 0;
  }
  .idtag svg {
    width: 3.2cqw;
    height: 3.2cqw;
    color: #e9b48e;
  }
  .phone[data-screen='wardrobe'] .idtag {
    animation: tagIn 0.7s var(--ease-ios) both;
    animation-delay: 1.15s;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 2.8cqw;
  }
  .card {
    display: flex;
    align-items: center;
    gap: 3.2cqw;
    background: #fff;
    border-radius: 4.8cqw;
    padding: 2.8cqw;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.04),
      0 6cqw 10cqw -8cqw rgba(0, 0, 0, 0.14);
  }
  .phone[data-screen='today'] .card {
    animation: dealIn 0.8s var(--ease-ios) both;
    animation-delay: calc(160ms + var(--i) * 95ms);
  }
  .card__meta {
    flex: 1;
    min-width: 0;
  }
  .card__name {
    font-size: 3.9cqw;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .card__vibe {
