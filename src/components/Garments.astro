---
/**
 * Vector garment library. Rendered once per page; every garment in the phone UI
 * is a <use> of one of these symbols, coloured with currentColor.
 * The drawings themselves live in content/garments.ts, shared with the 3D scene.
 */
import { shapes, paintHex } from '../content/garments';

const kinds = Object.entries(shapes);
const ink = (tone: string, color?: string) => (tone === 'paint' ? (paintHex[color ?? ''] ?? color ?? '#000') : tone === 'light' ? '#fff' : '#000');
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    {kinds.map(([kind, shape]) => (
      <symbol id={`g-${kind}`} viewBox="0 0 100 100">
        <path d={shape.body} fill="currentColor" stroke-linejoin="round" />
        {shape.details.filter((p) => !p.soft).map((p) => {
          const c = ink(p.tone, p.color);
          if (p.c) return <circle cx={p.c[0]} cy={p.c[1]} r={p.c[2]} fill={c} fill-opacity={p.opacity} />;
          if (p.mode === 'fill') return <path d={p.d} fill={c} fill-opacity={p.opacity} />;
          return (
            <path
              d={p.d}
              fill="none"
              stroke={c}
              stroke-opacity={p.opacity}
              stroke-width={p.width}
              stroke-linecap={p.round ? 'round' : undefined}
              stroke-linejoin={p.round ? 'round' : undefined}
              stroke-dasharray={p.dash}
            />
          );
        })}
      </symbol>
    ))}
  </defs>
</svg>
