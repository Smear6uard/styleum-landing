---
import { site, cta } from '../site';
import Cta from './Cta.astro';
---

<section id="download" class="cta grain" data-nav-theme="light">
  <div class="horizon"></div>
  <div class="wrap cta__inner">
    <p class="eyebrow" data-reveal>Next looks in <span class="cta__count" data-countdown>—</span></p>
    <h2 class="display h1 cta__title" data-lines>
      <span class="line"><span class="line__in"><span data-day>Tomorrow,</span></span></span>
      <span class="line"><span class="line__in"><em>{site.ritualTime} AM.</em></span></span>
    </h2>
    <p class="lede cta__lede" data-reveal style="--d:120ms">
      Four outfits from the clothes you already own, on your lock screen before you have had coffee.
    </p>
    <div class="cta__row" data-reveal style="--d:200ms">
      <Cta variant="chalk" />
      <p class="mono cta__note">{cta.note}</p>
    </div>
  </div>
  <div class="cta__dawn" aria-hidden="true"></div>
</section>

<script>
  // A real clock: time until the visitor's next 9:00, in their own timezone.
  const out = document.querySelector<HTMLElement>('[data-countdown]');
  const day = document.querySelector<HTMLElement>('[data-day]');
  const pad = (n: number) => String(n).padStart(2, '0');
  const tick = () => {
    const now = new Date();
    const next = new Date(now);
    next.setHours(9, 0, 0, 0);
    if (next <= now) next.setDate(next.getDate() + 1);
    const diff = Math.max(0, next.getTime() - now.getTime());
    const h = Math.floor(diff / 3.6e6);
    const m = Math.floor((diff % 3.6e6) / 6e4);
    const s = Math.floor((diff % 6e4) / 1e3);
    if (out) out.textContent = `${pad(h)}h ${pad(m)}m ${pad(s)}s`;
    if (day) day.textContent = next.getDate() === now.getDate() ? 'Today,' : 'Tomorrow,';
  };
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-chalk);
    padding-block: clamp(6rem, 16vw, 13rem) clamp(7rem, 18vw, 15rem);
  }
  .horizon {
    position: absolute;
    inset: 0 0 auto 0;
  }
  .cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cta__count {
    font-variant-numeric: tabular-nums;
    opacity: 1;
    color: var(--color-dawn);
  }
  .cta__title {
    margin: 1.5rem 0 1.75rem;
  }
  .cta__lede {
    margin: 0 auto 2.5rem;
    opacity: 0.72;
    text-align: center;
  }
  .cta__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .cta__note {
    margin: 0;
    opacity: 0.55;
  }
  .cta__dawn {
    position: absolute;
    left: 50%;
    bottom: -40vw;
    width: 140vw;
    height: 70vw;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(233, 180, 142, 0.34), rgba(91, 108, 158, 0.18) 45%, transparent 72%);
    filter: blur(40px);
    pointer-events: none;
    animation: breathe 9s ease-in-out infinite;
  }
</style>
