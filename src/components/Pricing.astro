---
import { site } from '../site';
import Cta from './Cta.astro';

const free = [
  `Four outfits at ${site.ritualTime}, every day`,
  'Weather-checked where you are',
  'Up to 50 wardrobe items',
  'Streaks and outfit history',
];

const pro = [
  'Everything in Free',
  'Unlimited outfits and Style Me',
  'Unlimited wardrobe',
  'Occasion styling',
  'Style analytics',
  'Priority support',
];
---

<section id="pricing" class="pricing section" data-nav-theme="dark">
  <div class="wrap">
    <div class="pricing__head">
      <p class="eyebrow" data-reveal>Pricing</p>
      <h2 class="display h2" data-lines>
        <span class="line"><span class="line__in">Free every morning.</span></span>
        <span class="line"><span class="line__in"><em>Pro</em> when you want more.</span></span>
      </h2>
    </div>

    <div class="plans">
      <div class="plan" data-reveal>
        <p class="eyebrow">Free</p>
        <p class="plan__price display">$0</p>
        <p class="plan__per mono">Forever</p>
        <ul class="plan__list">
          {free.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <div class="plan plan--pro" data-reveal style="--d:120ms">
        <p class="eyebrow">Pro</p>
        <p class="plan__price display">{site.pro.price}</p>
        <p class="plan__per mono">Per {site.pro.period} · cancel any time</p>
        <ul class="plan__list">
          {pro.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>

    <div class="pricing__foot" data-reveal style="--d:200ms">
      <Cta variant="solid" />
      <p class="mono muted">Billed through the App Store. Manage or cancel in Settings.</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .pricing__head {
    max-width: 62rem;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .pricing__head .h2 {
    margin-top: 1.25rem;
  }

  .plans {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-line);
  }
  .plan {
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .plan__price {
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 1;
    margin: 1rem 0 0.5rem;
    font-variant-numeric: lining-nums;
  }
  .plan__per {
    opacity: 0.55;
    margin: 0 0 2rem;
  }
  .plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 26rem;
  }
  .plan__list li {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    color: var(--color-graphite);
  }
  .plan__list li::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-ink);
    transform: translateY(-0.1rem);
  }
  .plan--pro .plan__list li::before {
    background: linear-gradient(135deg, var(--color-sky), var(--color-dawn));
  }

  .pricing__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .pricing__foot p {
    margin: 0;
  }

  @media (min-width: 760px) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
    .plan {
      padding-inline: clamp(2rem, 5vw, 4rem);
    }
    .plan:first-child {
      padding-left: 0;
      border-right: 1px solid var(--color-line);
    }
  }
</style>
