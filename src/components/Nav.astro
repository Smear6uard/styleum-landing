---
import Cta from './Cta.astro';

const links = [
  { label: 'How it works', href: '/#wardrobe' },
  { label: 'The label', href: '/#label' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'FAQ', href: '/#faq' },
];
---

<header class="nav" id="nav">
  <a class="nav__brand" href="/" aria-label="Styleum home">
    <img class="nav__mark" src="/StyleumLogo1.png" alt="" width="28" height="28" decoding="async" />
    <span class="nav__word">Styleum</span>
  </a>

  <nav class="nav__links" aria-label="Primary">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>

  <Cta class="nav__cta" size="sm" text="short" />
</header>

<style>
  .nav {
    --fg: var(--color-chalk);
    --bg: var(--color-ink);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-inline: var(--gutter);
    color: var(--fg);
    transition:
      color 0.6s,
      transform 0.6s var(--ease-out-expo);
  }
  :global(html[data-nav='dark']) .nav {
    --fg: var(--color-ink);
    --bg: var(--color-chalk);
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 8%, transparent);
    opacity: 0;
    transition: opacity 0.5s, background-color 0.6s;
  }
  .nav.is-scrolled::before {
    opacity: 1;
  }
  /* Phones: a near-solid bar. Backdrop blur on a fixed element is a scroll-jank source on iOS. */
  @media (max-width: 899px) {
    .nav::before {
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  .nav.is-hidden {
    transform: translateY(-100%);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .nav__mark {
    width: 26px;
    height: 26px;
    transition: filter 0.6s;
  }
  :global(html:not([data-nav='dark'])) .nav__mark {
    filter: invert(1);
  }
  .nav__word {
    font-family: var(--font-display);
    font-size: 1.45rem;
    letter-spacing: -0.01em;
    line-height: 1;
    transform: translateY(-1px);
  }

  .nav__links {
    display: none;
    gap: 2rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .nav__links a {
    position: relative;
    text-decoration: none;
    opacity: 0.72;
    transition: opacity 0.3s;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out-expo);
  }
  .nav__links a:hover {
    opacity: 1;
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav :global(.nav__cta) {
    background: var(--fg);
    color: var(--bg);
  }

  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    let last = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = Math.max(0, window.scrollY);
      nav.classList.toggle('is-scrolled', y > 24);
      // Ignore tiny deltas (rubber-banding, address-bar settles) so the bar does not flicker.
      if (Math.abs(y - last) > 8) {
        nav.classList.toggle('is-hidden', y > last && y > 240);
        last = y;
      }
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
    update();
  }
</script>
